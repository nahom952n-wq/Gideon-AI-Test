FLASK_SECRET_KEY=replace-with-a-unique-random-value-at-least-32-characters

# Configure AI providers through local environment variables or ScholarMind Settings.
# Never commit real API keys.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
LOCAL_AI_URL=
LOCAL_AI_MODEL=qwen2.5

# Public deployment owner bootstrap (used to grant admin on registration)
SCHOLARMIND_ADMIN_EMAIL=

# Optional Telegram Bot API integration (separate from user-account Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false

# Telegram user API credentials are application credentials; user sessions must remain per-user.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
